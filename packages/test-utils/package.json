{
  "name": "@valorasec/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test fixtures, factories, and helpers for ValoraSec",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@valorasec/shared": "workspace:*"
  },
  "optionalDependencies": {
    "react": ">=18",
    "supertest": ">=6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  }
}
