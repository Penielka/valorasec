# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string (required).
# For local dev, use the Docker Compose Postgres instance.
DATABASE_URL="postgresql://postgres:valorasec@localhost:5432/valorasec?schema=public"

# ── Authentication ───────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens (required).
# Generate a strong unique value: openssl rand -base64 64
JWT_SECRET="valorasec-secret-change-me"

# JWT access token expiration (default: 15m).
JWT_EXPIRES_IN="15m"

# JWT refresh token expiration in milliseconds (default: 7 days).
JWT_REFRESH_EXPIRES_IN_MS="604800000"

# ── Server ────────────────────────────────────────────────────────────────
# Port the API server listens on (default: 4000).
PORT="4000"

# Allowed CORS origin (the frontend URL).
# In development, this is the Next.js dev server.
CORS_ORIGIN="http://localhost:3000"

# Runtime environment: development | production | test
NODE_ENV="development"

# ── Redis (optional, planned for session/cache store) ─────────────────────
REDIS_URL="redis://localhost:6379"

# ── Stellar / Soroban ────────────────────────────────────────────────────
# Network to connect to: testnet | pubnet
STELLAR_NETWORK="testnet"

# Soroban RPC endpoint for the selected network.
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
