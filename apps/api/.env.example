# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string provided by Railway's PostgreSQL addon.
# Format: postgresql://user:password@host:port/dbname
# Railway auto-injects this; for local dev, update with your credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/valorasec"

# ── Authentication ───────────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens.
# Generate a strong, unique value: openssl rand -base64 32
JWT_SECRET="valorasec-secret-change-me"

# ── Server ────────────────────────────────────────────────────────────────
# Port the API server listens on. Railway sets this automatically via PORT.
PORT=4000

# Allowed CORS origin (the frontend URL).
# In production, set this to your Vercel frontend URL.
CORS_ORIGIN="http://localhost:3000"

# ── Stellar ──────────────────────────────────────────────────────────────
# Stellar network to connect to: 'testnet' or 'pubnet'
STELLAR_NETWORK="testnet"
